// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DocumentProcessing {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  name      String?
  password  String
  documents Document[]
}

model Document {
  id           Int                @id @default(autoincrement())
  fileName     String
  fileUrl      String
  status       DocumentProcessing
  summary      String?
  rawText      String?
  userId       Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  errorMessage String?
  user         User               @relation(fields: [userId], references: [id])

  @@index([userId])
}
